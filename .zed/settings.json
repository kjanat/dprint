// Folder-specific settings
// vim: set ft=jsonc:
//
// For a full list of overridable settings, and general information on folder-specific settings,
// see the documentation: https://zed.dev/docs/configuring-zed#settings-files
//
// mkdir -p .zed; curl -fsSLo .zed/settings.json https://github.com/kjanat/kjanat/raw/HEAD/.zed/settings.json
{
  "formatter": [{ "external": { "command": "dprint", "arguments": ["fmt", "--stdin", "{buffer_path}"] } }],
  "prettier": { "allowed": false },
  "languages": {
    "TypeScript": {
      "format_on_save": "on",
      "formatter": { "external": { "command": "dprint", "arguments": ["fmt", "--stdin", "{buffer_path}"] } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "language_servers": ["deno", "biome"] // https://github.com/kjanat/zed-typescript
    },
    "JavaScript": {
      "format_on_save": "on",
      "formatter": { "external": { "command": "dprint", "arguments": ["fmt", "--stdin", "{buffer_path}"] } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "language_servers": ["deno", "biome"] // https://github.com/kjanat/zed-typescript
    },
    "TSX": {
      "formatter": { "external": { "command": "dprint", "arguments": ["fmt", "--stdin", "{buffer_path}"] } },
      "code_actions_on_format": {
        "source.fixAll.biome": true,
        "source.organizeImports.biome": true
      },
      "language_servers": ["deno", "biome"] // https://github.com/kjanat/zed-typescript
    },
    "Markdown": {
      "language_servers": ["!markdownlint", "rumdl", "..."]
    }
  },
  "lsp": {
    "deno": {
      "settings": {
        "deno": {
          "enable": true,
          "enablePaths": ["./website", "./website/playground"],
          "config": "./website/deno.json"
        }
      }
    },
    "biome": {
      "settings": {
        // "config_path": "./biome.jsonc",
        "require_config_file": false,
        "goto_definition": true,
        "inline_config": {
          "formatter": { "enabled": false },
          "linter": {
            "enabled": true,
            "rules": { "preset": "recommended" }
          },
          "assist": {
            "enabled": true,
            "actions": {
              "source": {
                "organizeImports": "on"
              }
            }
          },
        }
      }
    },
  }
}
