{
  "workspace": [
    "./playground"
  ],
  "nodeModulesDir": "manual",
  "tasks": {
    "lume": "echo \"import 'lume/cli.ts'\" | deno run -A -",
    "build:ci": "deno task build && cp -r playground/dist _site/playground",
    "build": "deno task lume",
    "serve": "deno task lume -s"
  },
  "imports": {
    "compress": "https://deno.land/x/compress@v0.5.6/mod.ts",
    "lume/": "https://cdn.jsdelivr.net/gh/lumeland/lume@3.3.2/",
    "markdown-it-anchor": "npm:markdown-it-anchor@10.0.0"
  },
  "allowScripts": [
    "npm:fsevents",
    "npm:@parcel/watcher",
    "npm:core-js-pure",
    "npm:core-js"
  ]
}
